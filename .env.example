# ============================================================
# LawRAG 环境变量模板
# 用法：cp .env.example .env  然后填入真实值
# ⚠️ .env 已被 .gitignore 忽略，绝不要提交
# ============================================================

# ---------- 应用 ----------
APP_NAME=LawRAG
ENV=dev                      # dev / prod
DEBUG=true

# ---------- 数据库 ----------
# MySQL（与 D:\Go work 的学习项目共用同一套经验）
ASYNC_DATABASE_URL=mysql+aiomysql://root:你的密码@localhost:3306/lawrag?charset=utf8mb4

# ---------- 跨域 ----------
CORS_ORIGINS=http://localhost:8501

# ---------- LLM Provider ----------
# 可选：ollama / deepseek
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:7b
LLM_TEMPERATURE=0

# 备选：DeepSeek（LLM_PROVIDER=deepseek 时使用）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# ---------- Embedding ----------
EMBED_MODEL=bge-m3
EMBED_DIM=1024

# ---------- Reranker ----------
# 可选：siliconflow / local / none
RERANK_PROVIDER=siliconflow
RERANK_MODEL=BAAI/bge-reranker-v2-m3
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# ---------- 向量库 ----------
CHROMA_DIR=./chroma_data
VECTORSTORE=chroma            # chroma / qdrant（抽象层预留）

# ---------- 检索默认参数（可被 knowledge_bases.config 覆盖）----------
RETRIEVAL_MODE=hybrid         # bm25 / vector / hybrid
RETRIEVAL_TOP_K=20            # 粗排召回量
RERANK_TOP_N=5                # 精排后进 prompt 的数量
RRF_K=60                      # RRF 融合参数（出处：FastGPT）
SCORE_THRESHOLD=0.3           # rerank 分数阈值，低于此值丢弃

# ---------- 法律领域 ----------
DEFAULT_REGION=全国            # 地方性法规预留字段，第一版不做本地化
